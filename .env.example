NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Settings -> API -> Project API keys -> service_role (secret). Server-only,
# never expose to the browser. Required for invite/enrollment actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Your real deployed URL in production (e.g. https://your-app.onrender.com).
# Also add "${this}/accept-invite" to Supabase dashboard -> Authentication ->
# URL Configuration -> Redirect URLs, or invite links won't work.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
