# Server-side only (never exposed to the browser). Required for the
# Staff/Apprentice/Freelancer "Invite" flows and Business enrollment,
# which call supabase.auth.admin.*. Get the real value from: Supabase
# dashboard -> your project -> Settings -> API -> Project API keys ->
# service_role (secret). The placeholder below will cause "Invalid API
# key" errors on any of those actions until replaced.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where invite/recovery emails send people back to (see src/lib/site-url.ts).
# Set this to your real deployed URL in production — without it, invite
# links default to localhost, which only works on your own machine.
# IMPORTANT: also add "${NEXT_PUBLIC_SITE_URL}/accept-invite" (or a
# wildcard like "https://your-app.onrender.com/**") to Supabase dashboard
# -> Authentication -> URL Configuration -> Redirect URLs, or Supabase
# will silently ignore this and fall back to its own default.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
